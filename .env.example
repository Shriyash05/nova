# ==============================================================================
# NOVA Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server-Side Secrets (Stored on Vercel / Cloud Backend - Never in Browser!)
# ------------------------------------------------------------------------------

# Notion OAuth Integration Credentials (create at https://www.notion.so/profile/integrations)
NOTION_CLIENT_ID=your_notion_oauth_client_id
NOTION_CLIENT_SECRET=your_notion_oauth_client_secret

# Notion OAuth Redirect Callback URL
# Production: https://buynovastore.vercel.app/api/v1/auth/notion/callback
# Local Dev:   http://localhost:5173/api/v1/auth/notion/callback
NOTION_REDIRECT_URI=https://buynovastore.vercel.app/api/v1/auth/notion/callback

# 32-Byte Hex Encryption Key for AES-256-GCM token encryption at rest
# Generate with: openssl rand -hex 32
NOTION_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Persistent PostgreSQL Database Connection String (Supabase / Neon / Postgres)
# If omitted in development, an embedded in-memory fallback store is used.
DATABASE_URL=postgresql://postgres.yourproject:yourpassword@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# Database Pool TLS & Certificate Authority Configuration
# Provide custom Root CA certificate for strict TLS verification (rejectUnauthorized: true).
# Supports: multiline PEM string, single-line string with '\n', base64-encoded PEM, or cert file path.
# Required in production on Vercel when connecting to Supabase poolers presenting private Root CA.
DATABASE_SSL_CA=
# Optional override to enforce or bypass TLS verification ('true' or 'false').
# Default: true in production / when CA configured; false in test runners.
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Optional Supabase API Credentials
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ------------------------------------------------------------------------------
# 2. Frontend / Client-Side Variables (Vite Bundle)
# ------------------------------------------------------------------------------

# Base URL for the NOVA Cloud Backend (leave empty for relative /api/v1 paths)
VITE_API_BASE_URL=

# Explicit Mock Mode toggle ('true' or 'false').
# NOTE: In production builds, mock mode is strictly prohibited and disabled automatically.
VITE_MOCK_API=false

# Public Client ID for redirect building (Client secret is NEVER exposed to client)
VITE_NOTION_CLIENT_ID=your_notion_oauth_client_id
