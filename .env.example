# NOVA Web Onboarding Environment Variables

# Base URL for the NOVA Cloud Backend (leave empty for relative paths or mock mode)
VITE_API_BASE_URL=

# Explicit Mock Mode toggle ('true' or 'false')
# Defaults to true in development/preview if unspecified
VITE_MOCK_API=true

# Notion OAuth Public Client ID (used only for generating redirect authorization URL)
# The client secret NEVER resides in frontend code or environment variables
VITE_NOTION_CLIENT_ID=nova_iot_client_9918

# Optional Web Bluetooth Service UUID override
VITE_BLE_SERVICE_UUID=00000001-6e6f-7661-7769-6669-70726f760000
